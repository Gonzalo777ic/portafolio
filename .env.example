# ─── Supabase ─────────────────────────────────────────────
# Project URL and anon (public) key from Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Only this email can access /admin. Create the user in
# Authentication → Users and disable public sign-ups.
ADMIN_EMAIL=you@example.com

# ─── Cloudinary (photos) ──────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Prisma (Postgres de Supabase) ────────────────────────
# Settings → Database → URI (modo Session / puerto 5432, no pooler 6543).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

