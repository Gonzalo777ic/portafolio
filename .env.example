# ─── Supabase ─────────────────────────────────────────────
# Project URL and anon (public) key from Settings → API
# Sin comillas en el valor (local y Vercel).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Only this email can access /admin. Create the user in
# Authentication → Users and disable public sign-ups.
ADMIN_EMAIL=you@example.com

# ─── Cloudinary (photos) ──────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Upload preset UNSIGNED: Cloudinary → Settings → Upload → Upload presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Prisma (Postgres de Supabase) ────────────────────────
# Misma URI en local (.env.local) y Vercel (Secret). Sin comillas.
# Supabase → Settings → Database → Connection pooling → Session (5432).
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true
